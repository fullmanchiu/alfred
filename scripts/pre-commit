#!/bin/bash
# Enhanced Pre-commit hook: 多维度代码质量检查
# 安装方法：cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "========================================="
echo "🔍 Pre-commit Hook 开始检查"
echo "========================================="
echo ""

# ==================== 检查1: 敏感信息 ====================
echo "🔐 检查敏感信息..."
SENSITIVE_FILES=$(git diff --cached --name-only | grep -E "\.(env|pem|key|secret)" || true)
if [ -n "$SENSITIVE_FILES" ]; then
    echo "❌ 警告：检测到可能的敏感文件："
    echo "$SENSITIVE_FILES"
    echo "请确认这些文件应该被提交！"
    echo "提示：使用 'git commit --no-verify' 强制提交"
    exit 1
fi
echo "✅ 敏感信息检查通过"
echo ""

# ==================== 检查2: 大文件 ====================
echo "📏 检查大文件..."
LARGE_FILES=$(git diff --cached --name-only | while read file; do
    FILE_SIZE=$(git cat-file -s :"$file" 2>/dev/null || echo 0)
    if [ "$FILE_SIZE" -gt 1048576 ]; then  # 1MB
        echo "$file ($((FILE_SIZE / 1024))KB)"
    fi
done)
if [ -n "$LARGE_FILES" ]; then
    echo "⚠️  警告：检测到大文件（>1MB）："
    echo "$LARGE_FILES"
    echo "建议使用Git LFS或添加到.gitignore"
    read -p "是否继续提交？(y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi
echo "✅ 大文件检查通过"
echo ""

# ==================== 检查3: Python服务 ====================
PYTHON_CHANGED=$(git diff --cached --name-only | grep -c "^py-service/" || true)
if [ "$PYTHON_CHANGED" -gt "0" ]; then
    echo "🐍 检测到Python服务改动，正在检查..."

    # 检查Python语法
    if command -v python3 &> /dev/null; then
        SYNTAX_ERRORS=$(git diff --cached --name-only | grep "^py-service/.*\.py$" | while read file; do
            if ! python3 -m py_compile "$file" 2>/dev/null; then
                echo "$file"
            fi
        done)

        if [ -n "$SYNTAX_ERRORS" ]; then
            echo "❌ Python语法错误："
            echo "$SYNTAX_ERRORS"
            echo "提示：使用 'git commit --no-verify' 跳过此检查"
            exit 1
        fi
        echo "✅ Python语法检查通过"
    else
        echo "⚠️  未安装Python3，跳过Python检查"
    fi
    echo ""
fi

# ==================== 检查4: 后端编译 ====================
BACKEND_CHANGED=$(git diff --cached --name-only | grep -c "^backend/src" || true)
if [ "$BACKEND_CHANGED" -gt "0" ]; then
    echo "📦 检测到后端改动，正在编译后端..."

    cd backend

    if [ ! -f "gradlew" ]; then
        echo "❌ 错误：backend/gradlew 不存在"
        exit 1
    fi

    chmod +x gradlew

    # 编译检查
    if ./gradlew compileKotlin --no-daemon -q; then
        echo "✅ 后端编译通过"
    else
        echo "❌ 后端编译失败，请修复后再提交"
        echo "提示：使用 'git commit --no-verify' 跳过此检查"
        exit 1
    fi

    cd ..
    echo ""
fi

# ==================== 检查5: 前端编译 ====================
FRONTEND_CHANGED=$(git diff --cached --name-only | grep -c "^frontend/src" || true)
if [ "$FRONTEND_CHANGED" -gt "0" ]; then
    echo "📦 检测到前端改动，正在编译前端..."

    cd frontend

    if [ ! -f "package.json" ]; then
        echo "❌ 错误：frontend/package.json 不存在"
        exit 1
    fi

    if [ ! -d "node_modules" ]; then
        echo "📦 正在安装前端依赖..."
        npm install
    fi

    # 编译检查
    if npm run build; then
        echo "✅ 前端编译通过"
    else
        echo "❌ 前端编译失败，请修复后再提交"
        echo "提示：使用 'git commit --no-verify' 跳过此检查"
        exit 1
    fi

    cd ..
    echo ""
fi

# ==================== 检查6: TODO/FIXME标记 ====================
echo "📝 检查TODO/FIXME标记..."
# 只检查代码文件（frontend/, backend/, py-service/），排除scripts目录
CHECK_FILES=$(git diff --cached --name-only | grep -E "^(frontend|backend|py-service)/.*\.(ts|tsx|kt|py)$" || true)
CHECK_COUNT=0
CHECK_LINES=""

if [ -n "$CHECK_FILES" ]; then
    while read file; do
        FILE_MARKERS=$(git diff --cached "$file" | grep -E "^\+.*//.*TODO|^\+.*//.*FIXME|^\+.*#.*TODO|^\+.*#.*FIXME" || true)
        if [ -n "$FILE_MARKERS" ]; then
            COUNT=$(echo "$FILE_MARKERS" | wc -l | tr -d ' ')
            CHECK_COUNT=$((CHECK_COUNT + COUNT))
            CHECK_LINES="${CHECK_LINES}${FILE_MARKERS}"$'\n'
        fi
    done <<< "$CHECK_FILES"
fi

if [ "$CHECK_COUNT" -gt "0" ]; then
    echo "⚠️  检测到 $CHECK_COUNT 个TODO/FIXME标记"
    echo "建议：在完成这些任务后再提交代码"
    echo ""
    echo "$CHECK_LINES" | head -5
    echo ""
    read -p "是否继续提交？(y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi
echo "✅ TODO检查通过"
echo ""

# ==================== 检查7: Commit Message格式（可选）====================
# 如果commit message为空或不符合规范，可以在这里检查

# ==================== 总结 ====================
echo "========================================="
echo "✅ 所有检查通过，可以提交"
echo "========================================="
echo ""
