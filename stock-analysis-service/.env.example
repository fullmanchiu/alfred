# 环境变量配置示例
# Environment Variables Configuration

# OpenAI API 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Anthropic API 配置（可选）
ANTHROPIC_API_KEY=your-anthropic-key-here

# 服务配置
PORT=8001
LOG_LEVEL=INFO

# 数据源配置（可选）
BAOSTOCK_TIMEOUT=30
AKSHARE_TIMEOUT=30
